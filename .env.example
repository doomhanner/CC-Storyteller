# CC-Storyteller Configuration
# Copy this file to .env and fill in your values

# ==================== API Keys ====================
# At least one provider is required

# Anthropic (Claude) - Recommended for best quality
ANTHROPIC_API_KEY=your_api_key_here

# OpenAI (GPT-4) - Alternative cloud provider
# OPENAI_API_KEY=your_openai_key_here

# Google (Gemini) - Alternative cloud provider
# GOOGLE_API_KEY=your_google_key_here

# ==================== Local Models ====================
# For running models locally via Ollama, llama.cpp, etc.

# URL for local model server
# STORYTELLER_LOCAL_PROVIDER_URL=http://localhost:11434

# Type of local provider (ollama, llamacpp, lmstudio, vllm)
# STORYTELLER_LOCAL_PROVIDER_TYPE=ollama

# ==================== Model Configuration ====================
# Configure which provider/model each agent uses

# Storyteller (narrative generation) - benefits from creative models
# STORYTELLER_MODELS__STORYTELLER__PROVIDER=anthropic
# STORYTELLER_MODELS__STORYTELLER__MODEL=claude-sonnet-4-20250514

# Archivist (logic/data) - benefits from reliable structured output
# STORYTELLER_MODELS__ARCHIVIST__PROVIDER=anthropic
# STORYTELLER_MODELS__ARCHIVIST__MODEL=claude-sonnet-4-20250514

# Example: Use local model for Storyteller, Claude for Archivist
# STORYTELLER_MODELS__STORYTELLER__PROVIDER=ollama
# STORYTELLER_MODELS__STORYTELLER__MODEL=llama3.2:8b
# STORYTELLER_MODELS__ARCHIVIST__PROVIDER=anthropic
# STORYTELLER_MODELS__ARCHIVIST__MODEL=claude-sonnet-4-20250514

# ==================== Paths ====================
# STORYTELLER_DATA_DIR=/path/to/data

# ==================== Debug ====================
# STORYTELLER_DEBUG=false
# STORYTELLER_LOG_PROMPTS=false
# STORYTELLER_LOG_RESPONSES=false
