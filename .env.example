# CC-Storyteller Configuration
# Copy this file to .env and fill in your values

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Custom data directory (defaults to ~/.cc-storyteller)
# STORYTELLER_DATA_DIR=/path/to/data

# Optional: Model overrides
# STORYTELLER_MODELS__STORYTELLER_MODEL=claude-sonnet-4-20250514
# STORYTELLER_MODELS__ARCHIVIST_MODEL=claude-sonnet-4-20250514

# Optional: Debug settings
# STORYTELLER_DEBUG=false
# STORYTELLER_LOG_PROMPTS=false
# STORYTELLER_LOG_RESPONSES=false
