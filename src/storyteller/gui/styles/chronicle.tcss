/* Chronicle - The CC-Storyteller Theme
   An ancient tome aesthetic for narrative simulation
*/

/* ==================== Global Styles ==================== */

Screen {
    background: $surface;
}

Header {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

Footer {
    background: $primary-darken-3;
}

/* ==================== Home Screen ==================== */

#home-container {
    layout: vertical;
    padding: 2;
    align: center middle;
}

#title-art {
    text-align: center;
    color: $warning;
    padding-bottom: 1;
}

#subtitle {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    padding-bottom: 2;
}

#campaign-list {
    width: 80%;
    height: auto;
    max-height: 60%;
    border: tall $primary;
    background: $surface-darken-1;
    padding: 1;
}

#campaign-list > .option-list--option {
    padding: 1 2;
}

#no-campaigns {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    padding: 2;
}

#action-buttons {
    layout: horizontal;
    align: center middle;
    padding-top: 2;
    width: 80%;
}

.action-button {
    margin: 0 1;
    min-width: 20;
}

/* ==================== Chronicle Screen (Gameplay) ==================== */

#chronicle-container {
    layout: vertical;
    height: 100%;
}

#narrative-scroll {
    height: 1fr;
    border: tall $primary;
    background: $surface-darken-1;
    padding: 1 2;
    scrollbar-gutter: stable;
}

.narrative-entry {
    margin-bottom: 1;
    padding: 1;
}

.narrative-text {
    color: $text;
}

.narrative-turn-tag {
    color: $text-muted;
    text-style: italic;
    text-align: right;
}

.player-input {
    color: $success;
    text-style: bold;
    border-left: tall $success;
    padding-left: 1;
    margin-bottom: 1;
}

.ooc-response {
    color: $primary-lighten-2;
    background: $surface-darken-2;
    padding: 1;
    border: round $primary;
}

#input-area {
    height: auto;
    dock: bottom;
    padding: 1;
    background: $surface-darken-2;
}

#player-input {
    width: 100%;
    border: tall $accent;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $primary-darken-2;
    padding: 0 1;
    layout: horizontal;
}

.status-item {
    margin-right: 2;
    color: $text-muted;
}

/* ==================== Codex Screen (Entity Bible) ==================== */

#codex-container {
    layout: horizontal;
    height: 100%;
}

#codex-sidebar {
    width: 30;
    border-right: tall $primary;
    background: $surface-darken-1;
}

#entity-tabs {
    height: 100%;
}

#entity-list {
    height: 1fr;
    padding: 1;
}

.entity-item {
    padding: 1;
    margin-bottom: 1;
    border: round $surface-lighten-1;
}

.entity-item:hover {
    background: $surface-lighten-1;
}

.entity-item.--selected {
    background: $primary-darken-1;
    border: round $primary;
}

#codex-detail {
    width: 1fr;
    padding: 2;
}

#entity-name {
    text-style: bold;
    color: $warning;
    padding-bottom: 1;
}

#entity-type {
    color: $text-muted;
    text-style: italic;
    padding-bottom: 1;
}

.detail-section {
    margin-bottom: 2;
}

.detail-header {
    color: $primary-lighten-1;
    text-style: bold;
    border-bottom: solid $primary;
    margin-bottom: 1;
}

.detail-content {
    padding-left: 1;
}

#relationships-panel {
    border: tall $accent;
    padding: 1;
    margin-top: 1;
}

/* ==================== Scriptorium Screen (Campaign Creation) ==================== */

#scriptorium-container {
    layout: vertical;
    padding: 2;
    align: center top;
}

#scriptorium-title {
    text-align: center;
    color: $warning;
    text-style: bold;
    padding-bottom: 1;
}

#scriptorium-subtitle {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    padding-bottom: 2;
}

.wizard-step {
    width: 80%;
    border: tall $primary;
    background: $surface-darken-1;
    padding: 2;
    margin-bottom: 1;
}

.step-title {
    color: $primary-lighten-1;
    text-style: bold;
    padding-bottom: 1;
}

.step-description {
    color: $text-muted;
    text-style: italic;
    padding-bottom: 1;
}

.wizard-input {
    width: 100%;
    margin-bottom: 1;
}

.wizard-textarea {
    width: 100%;
    height: 8;
    margin-bottom: 1;
}

#creativity-slider {
    width: 100%;
    margin: 1 0;
}

#wizard-buttons {
    layout: horizontal;
    align: center middle;
    padding-top: 2;
}

.wizard-button {
    margin: 0 1;
    min-width: 15;
}

#generation-progress {
    width: 80%;
    padding: 2;
    text-align: center;
}

/* ==================== Common Widgets ==================== */

.panel-title {
    color: $warning;
    text-style: bold;
    padding: 1;
    border-bottom: solid $primary;
}

.card {
    border: round $primary;
    background: $surface-darken-1;
    padding: 1;
    margin: 1;
}

.card-title {
    color: $primary-lighten-1;
    text-style: bold;
}

.card-content {
    padding-top: 1;
}

/* Relationship badges */
.relationship-badge {
    padding: 0 1;
    margin-right: 1;
}

.rel-positive {
    background: $success-darken-2;
    color: $success;
}

.rel-neutral {
    background: $surface-lighten-1;
    color: $text-muted;
}

.rel-negative {
    background: $error-darken-2;
    color: $error;
}

/* Loading states */
.loading {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    padding: 2;
}

/* Error states */
.error {
    color: $error;
    padding: 1;
    border: round $error;
}

/* Success states */
.success {
    color: $success;
    padding: 1;
    border: round $success;
}
